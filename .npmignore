# Things the published package doesn't need to run the tests or show their results. Everything
# else ships; note that having this file means .gitignore is no longer consulted.

# the annotated spec's build inputs (the built page and its assets ship)
/spec/Makefile
/spec/*.xml
/spec/lib/

# the Docker image's build files; test-docker.sh pulls the image instead
/docker/

# repository tooling
/.editorconfig
/.github/
/CNAME

# local state
/server.pid
